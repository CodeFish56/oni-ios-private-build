<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../obj/WorldgenReference/</BaseIntermediateOutputPath>
    <BaseOutputPath>../bin/WorldgenReference/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- .txt keeps the parent SimReference project's implicit compile isolated. -->
  <ItemGroup><Compile Include="WorldgenReference.cs.txt" /></ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
